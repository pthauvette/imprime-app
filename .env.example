# ═══════════════════════════════════════════════════════════════════
# IMPRIME — Variables d'environnement
# Copie ce fichier en .env.local et remplis les valeurs
# ═══════════════════════════════════════════════════════════════════

# ─── Database (Neon Postgres en prod, dev pareil) ──────────────────
# Récupère la connection string sur https://console.neon.tech
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# ─── Auth.js v5 ─────────────────────────────────────────────────────
# Génère avec : openssl rand -base64 32
AUTH_SECRET=

# Comma-separated list of emails auto-promus en role ADMIN à la signin.
# Bootstrap pour le portail /admin/*. Remplacer par UI admin plus tard.
ADMIN_EMAILS=patrickthauvette@gmail.com

# ─── Sinalite API (apifrontend_stage.sinaliteuppy.com → Account) ───
SINALITE_CLIENT_ID=your_client_id_here
SINALITE_CLIENT_SECRET=your_client_secret_here

# Sandbox: https://api.sinaliteuppy.com  ·  Prod: https://liveapi.sinalite.com
SINALITE_API_BASE=https://api.sinaliteuppy.com
SINALITE_AUDIENCE=https://apiconnect.sinalite.com
SINALITE_AUTH_BASE=https://api.sinaliteuppy.com

# Marché — Canada uniquement (en_ca string, PAS le 6 numérique de la doc obsolète)
SINALITE_STORE_CODE=en_ca

# Webhook secret pour vérifier la signature des callbacks Sinalite
SINALITE_WEBHOOK_SECRET=

# ─── Stripe (https://dashboard.stripe.com/apikeys) ─────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── AWS SES (email-smtp.<region>.amazonaws.com via SMTP) ──────────
# Crée les SMTP credentials dans la console SES > SMTP Settings.
# Vide en dev → les magic links sortent en console.
SES_SMTP_USER=
SES_SMTP_PASS=
SES_SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SES_FROM=Plio <bonjour@plio.ca>

# ─── S3 (uploads PDF/AI/PSD pour les designs print) ────────────────
# Bucket public-read avec UUIDs cryptiques dans le path. IAM user
# avec permission s3:PutObject + s3:GetObject sur le bucket seulement.
S3_REGION=ca-central-1
S3_BUCKET=plio-uploads-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Sentry (error tracking, optionnel — pas configuré = noop) ────
# Crée un compte gratuit sur https://sentry.io → New Project (Next.js)
# Récupère le DSN sur le projet. Le SENTRY_AUTH_TOKEN active aussi
# l'upload des sourcemaps au build (sinon noop).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
