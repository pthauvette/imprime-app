{
  "name": "imprime-app",
  "displayName": "Plio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "lint:no-floating": "eslint --config eslint.no-floating.config.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "e2e:headed": "playwright test --headed",
    "build:mcp-widget": "node scripts/build-mcp-widget.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-presigned-post": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pdfme/common": "^6.1.2",
    "@pdfme/generator": "^6.1.2",
    "@pdfme/schemas": "^6.1.2",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.53.1",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.5.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "mcp-handler": "1.1.0",
    "next": "^15.1.0",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.5.0",
    "three": "^0.185.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.0",
    "prisma": "^6.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "@prisma/client"
    ],
    "overrides": {
      "@smithy/types": "4.16.1",
      "@smithy/core": "3.29.6",
      "@smithy/signature-v4": "5.6.7"
    },
    "overridesComment": "Deux copies de @smithy/* (via client-s3 vs s3-request-presigner) rendaient les S3Client mutuellement incompatibles au niveau des types. Pins DURS volontaires : un futur `pnpm up @aws-sdk/*` retiendrait @smithy en arrière sans bruit. À retirer quand l'amont sera dédoublonné ; re-tester la signature (upload presigned POST + getSignedUrl) à chaque bump du SDK AWS."
  }
}
