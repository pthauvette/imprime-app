// Imprime — Prisma schema (SQLite for dev).
// SQLite n'a pas d'enums natifs — on stocke en string + on contraint via Zod
// côté app. JSON sérialisé en string aussi (pas de Json natif).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase (2026-07) : split pooler / direct.
  //  - url = DATABASE_URL : Supavisor pooler (port 6543, ?pgbouncer=true) pour
  //    le RUNTIME. Amplify = Lambda SSR → connexions éphémères nombreuses ; le
  //    pooler évite d'épuiser le max_connections Postgres (Neon poolait tout
  //    seul, Supabase exige le split explicite).
  //  - directUrl = DIRECT_URL : connexion DIRECTE (port 5432) pour les MIGRATIONS
  //    (prisma migrate deploy). Le pooler transaction-mode ne supporte pas les
  //    verrous/DDL de migrate → obligatoire.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USER + AUTH.JS ───────────────────────────────────────────────────────
// User est utilisé à la fois par Auth.js (sessions) et nos features (orders).
// Les champs `name`, `image`, `emailVerified` sont attendus par Auth.js.
// `firstName`/`lastName`/`phone` sont nos extensions métier.
//
// Pattern guest → user :
//   1. Visiteur passe une commande sans compte → on crée un User par email
//   2. Plus tard, il sign-in via Email magic link → Auth.js link-or-create
//      par email → tombe sur le même User → historique préservé.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?

  // Champs métier
  firstName String?
  lastName  String?
  phone     String?

  // USER | ADMIN — gating le portail /admin/*. Bootstrap via env ADMIN_EMAILS,
  // ensuite mutable via une UI admin (pas encore implémentée).
  role String @default("USER")

  // Email preferences (CASL compliance — Canadian anti-spam law).
  // Transactional emails (magic link, order confirmation, cancellation,
  // refund) ne sont JAMAIS opt-out — requis pour que le service marche.
  // Les autres types sont opt-able indépendamment :
  //   - emailDeliveryNotifications : ship/delivered (legacy nom, kept pour
  //     ne pas casser le check existant — c'est le toggle "live order updates")
  //   - emailMarketing : broadcasts admin (newsletter, annonces, tier campagnes)
  //   - emailReengagement : winback + post-delivery follow-up
  // Loi 25 — emailMarketing défaut FALSE : le consentement marketing doit être
  // AFFIRMATIF (opt-in explicite via la case du sign-up). Un compte créé sans
  // cocher (ou via connexion directe) reste opt-out. Les notifs livraison
  // (transactionnelles) restent défaut true (relation d'affaires existante).
  emailDeliveryNotifications Boolean @default(true)
  emailMarketing             Boolean @default(false)
  emailReengagement          Boolean @default(true)

  // ─── Parrainage ────────────────────────────────────────────────────────
  // Le code unique de cet user pour parrainer (ex: "PATRICK7H4N").
  // Généré lazy à la 1ère visite de /account/referrals (ne pas backfill).
  referralCode               String?   @unique
  // Code utilisé à l'inscription (cookie plio_ref capturé sur le landing).
  // First-write-wins : si déjà set, ne pas écraser même si autre ref visité.
  referredByCode             String?
  // Crédit de parrainage accumulé en cents CAD. Déduit auto au prochain
  // checkout (logique dans api/orders/create). Ne peut pas devenir négatif.
  referralCreditCents        Int       @default(0)

  // Round 18 #1 — Wallet prepaid balance en cents CAD. Top-up via Stripe
  // Checkout (cf POST /api/wallet/topup) + bonus tier (5/8/12% selon
  // amount). Append-only ledger via WalletTransaction pour audit.
  // Déduit AVANT le referralCreditCents au checkout (FIFO du plus
  // restrictif au plus flexible).
  walletCents                Int       @default(0)
  walletTransactions         WalletTransaction[] @relation("WalletTransactionUser")
  // Round 37 #4 — Inverse pour adminId → User (ADMIN_ADJUSTMENT, REFUND
  // par admin). SetNull si admin supprimé (PIPEDA) pour préserver le ledger.
  walletAdminActions         WalletTransaction[] @relation("WalletTransactionAdmin")

  // Round 19 #3 — Rolling expiration : si le wallet n'a aucune activité
  // (topup OU spend) depuis 12 mois → expire. lastActivityAt est bumpé à
  // chaque recordWalletTx. NULL = jamais d'activité (donc rien à expirer).
  // walletExpiryWarningAt = quand on a envoyé le heads-up email à 11 mois
  // (dédup : 1 warning par cycle de 12 mois).
  walletLastActivityAt       DateTime?
  walletExpiryWarningAt      DateTime?

  // Round 22 #3 — Auto-renew via Stripe Subscription. 1 sub par user MVP.
  // Le user choisit un montant fixe à recharger chaque mois (cf
  // WALLET_TIERS preset). Webhook invoice.paid → recordWalletTx TOPUP.
  // Webhook subscription.deleted → nullify ces fields.
  walletAutoRenewStripeSubId String?
  /** Cents par mois (matche un tier de WALLET_TIERS). */
  walletAutoRenewAmountCents Int?
  /** Round 28 #5 — timestamp de pause (Stripe subscription.update pause_collection).
   *  NULL = active. Set = paused. Resume = clear ce field + reprendre billing.
   *  Pause préserve l'abonnement (vs cancel) — l'user peut resume sans
   *  re-saisir card. Use cases : congé sabbatique, slow season pour reseller. */
  walletAutoRenewPausedAt    DateTime?

  // Round 18 #5 — Tax-exempt B2B (resellers + registered cas spéciaux).
  // taxExempt=true → checkout calcule TPS/TVQ=0. taxExemptCertId stocke
  // le numéro de certificat d'exemption (TPS, TVQ, Indian-status, diplomat)
  // pour traçabilité audit Revenu Québec / ARC. Admin-only toggle (le
  // self-serve serait fraud-prone — back-tax owed si déclaration mensongère).
  taxExempt                  Boolean   @default(false)
  taxExemptCertId            String?

  // Round 21 #4 — Reseller status auto-détecté par cron monthly :
  //   NONE          : default (< 5 orders/365j ou moins)
  //   AUTO_DETECTED : 5+ orders dans les 365 derniers jours, candidat
  //   VERIFIED      : admin a manuellement confirmé (badge "Reseller officiel")
  // resellerDetectedAt = quand le cron a basculé en AUTO_DETECTED (audit).
  resellerStatus             String    @default("NONE")
  resellerDetectedAt         DateTime?

  // ─── Loyalty tier ─────────────────────────────────────────────────────
  // Tier basé sur le revenu net 365 derniers jours. Recomputé mensuellement
  // via /api/cron/loyalty-tiers. Sert à :
  //  - Display badge sur /account
  //  - Future : free shipping GOLD, priorité production, etc.
  // BRONZE = default, SILVER ≥ $500/an, GOLD ≥ $2000/an.
  // Cf src/lib/customers/loyalty.ts.
  loyaltyTier              String   @default("BRONZE")
  /** Dernière fois que le tier a été recalculé. NULL = jamais. */
  loyaltyTierComputedAt    DateTime?

  // ─── Notes admin ───────────────────────────────────────────────────────
  // Memo interne admin sur ce customer (free-text, jamais affiché au user).
  // Use cases : "client réticent au paiement carte", "appelle plutôt qu'écrit",
  // "rev marketing du 18 mai", "à appeler si commande > 1k$". Visible sur
  // /admin/users/[id] ET surfacé sur /admin/orders/[id] quand on traite une
  // commande de ce user (contexte rapide sans navigation).
  adminNotes        String?
  /** Dernière fois qu'un admin a édité adminNotes — pour signaler stale. */
  adminNotesUpdatedAt DateTime?
  /** Email de l'admin qui a fait la dernière édition (audit lite). */
  adminNotesUpdatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  orders            Order[]
  addresses         Address[]
  drafts            Draft[]
  designDrafts      DesignDraft[]
  savedConfigs      SavedConfig[]
  apiKeys           ApiKey[]
  mcpOrderIntents   McpOrderIntent[]
  referralsEarned   ReferralReward[] @relation("ReferralReferrer")
  referralReceived  ReferralReward?  @relation("ReferralReferee")
  deleteRequests    DeleteAccountRequest[]
  /** Round 26 #5 — filtres bookmarkés per-admin */
  savedFilters      AdminSavedFilter[]

  @@index([email])
  @@index([referredByCode])
}

// Auth.js tables — schéma standard Prisma adapter
// https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ORDER ────────────────────────────────────────────────────────────────
// Source of truth pour les commandes payées. Créé par le webhook Stripe
// payment_intent.succeeded. status reflète le lifecycle:
//   PAID → SUBMITTED (envoyé à Sinalite) → IN_PRODUCTION → SHIPPED → DELIVERED
//   CANCELLED / FAILED si Sinalite refuse (on refund Stripe dans ce cas).

model Order {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])

  // Stripe
  paymentIntentId  String   @unique
  amountCents      Int
  currency         String   @default("CAD")
  paidAt           DateTime?

  // Sinalite — null jusqu'à ce que /order/new ait répondu
  sinaliteOrderId  String?  @unique

  // finding [17] — jours de production/transit RÉELS captés au moment de la
  // commande (Turnaround sélectionné + devis transporteur signé, cf.
  // /api/shipping/estimate). NULL = commande créée avant ce fix, résolution
  // Sinalite indisponible à la commande, ou commande créée via MCP headless
  // (create_order Mode B ne les capte pas encore) → computeOrderEta retombe
  // sur l'heuristique forfaitaire 7j/3j, jamais de régression.
  productionDays   Int?
  transitDays      Int?

  // Lifecycle: PENDING | PAID | SUBMITTED | IN_PRODUCTION | SHIPPED | DELIVERED | CANCELLED | FAILED
  status           String   @default("PENDING")
  failureReason    String?

  // Snapshot complet du payload envoyé à Sinalite (JSON string)
  // Permet de rejouer ou debug sans dépendre d'une refetch.
  sinalitePayload  String

  // Snapshot human-readable du produit pour affichage emails + admin sans
  // refetch. Format libre : "Cartes 14pt + UV (250)" ou multi-items
  // "Cartes 14pt (250) + Flyers 8.5×11 (100)".
  productSummary   String?

  // Snapshot structuré multi-item pour /orders UI itemized (Phase 2).
  // JSON string array de DisplayItem (cf. lib/orders/items.ts) :
  //   [{ productId, productName, options:[{group,label}], qty, qtyLabel,
  //      turnaround?, unitPriceCents?, subtotalCents? }, ...]
  // Nullable pour compat ascendante : les vieilles orders pré-Phase 2 ont
  // null ici, les renderers retombent gracefully sur productSummary.
  itemsSnapshot    String?

  // Snapshot pour /orders UI (évite roundtrip Sinalite à chaque view)
  itemsCount       Int
  subtotalCents    Int
  shippingCents    Int
  taxCents         Int
  /** Montant remisé en cents (promo code). 0 si pas de promo. */
  discountCents    Int      @default(0)
  /** Lien vers le PromoCode appliqué. Null si pas de promo. */
  promoCodeId      String?
  promoCode        PromoCode? @relation(fields: [promoCodeId], references: [id])
  /** Crédit de parrainage déduit à ce checkout (cents). 0 si l'user n'avait
   *  pas de balance ou a choisi de ne pas l'appliquer. Permet d'audit
   *  pourquoi le total payé est < subtotal + shipping + tax. */
  referralCreditAppliedCents Int @default(0)
  /** Round 20 #3 — Wallet prepaid credit déduit à ce checkout (cents).
   *  Appliqué AVANT le referralCredit (FIFO du plus restrictif au plus
   *  flexible : wallet = "argent" déjà payé, referral = bonus marketing). */
  walletCreditAppliedCents   Int @default(0)
  /** Round 22 #2 — Reseller 5% discount snapshot. Auto-appliqué au
   *  checkout si user.resellerStatus = VERIFIED. Separate from
   *  discountCents (PromoCode) pour finance KPIs distincts.
   *  Calculated sur subtotal (avant shipping + tax), comme un promo. */
  resellerDiscountCents      Int @default(0)
  shippingMethod   String
  province         String

  // Addresses (snapshot — on découple de Address pour ne pas casser
  // l'historique si user update son adresse plus tard)
  shipName         String
  shipLine1        String
  shipLine2        String?
  shipCity         String
  shipProvince     String
  shipPostalCode   String
  shipPhone        String

  /** Round 26 #2 — instructions de livraison customer-fournies
   *  (ex: "sonner deux fois", "porte arrière", "code 4321"). Max 200 chars.
   *  Forwarded à Sinalite dans le payload deliveryInstructions. NULL = aucune. */
  shippingNote     String?

  /** Notes internes admin (free-text). Jamais affichées au customer. */
  adminNotes       String?

  /** Round 27 #1 — Si cette Order a été placée suite à un click sur le
   *  recovery email d'un AbandonedCart, on track le source cart ici.
   *  SetNull pour pas orphaner la cart si on la delete. NULL = order
   *  organique (pas de recovery email impliqué). */
  recoveredFromCartId String?
  recoveredFromCart   AbandonedCart? @relation("OrderRecoveredFromCart", fields: [recoveredFromCartId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events           OrderEvent[]
  designDraft      DesignDraft?
  review           Review?
  npsResponse      NpsResponse?
  webhookEvents    WebhookEvent[]   @relation("OrderWebhookEvents")
  emailDeliveriesAttached EmailDelivery[] @relation("OrderEmailAttachments")
  referralReward   ReferralReward?  @relation("OrderReferralReward")
  contactMessages  ContactMessage[] @relation("OrderContactMessages")
  /** Round 37 #4 — Inverse pour WalletTransaction.orderId (ORDER_SPEND, REFUND).
   *  SetNull si Order purgé → preserve le ledger row pour audit. */
  walletTransactions WalletTransaction[]

  /** Round 39 #5 — Dedup pour order-sla-alerts cron. Set à `now` quand un
   *  admin reçoit l'email SLA pour cette order. Null = pas encore alerté
   *  (nouveau dans la pool stuck). Re-alerté après 7j (escalation) — la
   *  query du cron filtre `slaAlertedAt IS NULL OR slaAlertedAt < now-7d`.
   *  Évite que 1 order PAID-stuck-5-jours = 5 emails identiques admin. */
  slaAlertedAt     DateTime?

  @@index([userId, createdAt])
  @@index([status])
  /** Round 37 #4 — admin-weekly-digest + reseller-detection font des queries
   *  WHERE status IN (...) AND paidAt >= cutoff. Le single-index status seul
   *  est inutile pour le range scan paidAt. Composite réduit drastiquement
   *  le coût à mesure que Order grossit. */
  @@index([status, paidAt])
  @@index([recoveredFromCartId])
  /** Round 37 #4 — promoCodeId pas indexé : /admin/promo-codes/[id] loop
   *  prisma.order.findMany({where:{promoCodeId}}) → scan séquentiel à scale. */
  @@index([promoCodeId])
  /** Round 39 #5 — order-sla-alerts cron filter. */
  @@index([slaAlertedAt])
}

// ─── ORDER EVENT ──────────────────────────────────────────────────────────
// Audit trail. Chaque transition d'état + webhook reçu.

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // PAYMENT_SUCCEEDED | SINALITE_SUBMITTED | SINALITE_STATUS_CHANGED | REFUND_ISSUED | ERROR
  kind      String
  data      String?  // JSON payload du webhook ou contexte
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ─── ADDRESS ──────────────────────────────────────────────────────────────
// Carnet d'adresses utilisateur (page /account/addresses). Indépendant des
// snapshots dans Order (qui doivent rester immutables pour l'historique).

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHIPPING | BILLING — un user peut avoir N de chaque
  kind       String
  label      String?  // ex: "Bureau", "Maison"
  isDefault  Boolean  @default(false)

  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  province   String   // CA codes — AB, BC, ON, QC, ...
  postalCode String
  phone      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, kind])
}

// ─── DRAFT ────────────────────────────────────────────────────────────────
// Sauvegarde le wizard en cours pour qu'un user puisse reprendre.
// Auto-expire après 30 jours (cleanup via cron — pas implémenté pour MVP).

model Draft {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId  Int
  optionIds  String   // JSON: number[]
  files      String   // JSON: { type: 'front'|'back', url: string }[]
  lastStep   String   // "configure" | "quantity" | "upload" | "shipping" | "review"

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime

  @@index([userId, updatedAt])
  @@index([expiresAt])
}

// ─── TEMPLATE ─────────────────────────────────────────────────────────────
// Templates pdfme paramétrables. Le `data` est le JSON pdfme complet
// (basePdf + schemas). Pour MVP les templates sont créés par nous (admin)
// et stockés en DB ; pas de UI Designer côté user.

model Template {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String?
  // BUSINESS_CARD | FLYER | POSTCARD | BROCHURE
  productType  String
  // "3.5x2", "8.5x11", "5x7", "tri-fold", etc. — dimensions canoniques
  variant      String
  // FRONT | BACK | BOTH (pour les produits recto-verso)
  side         String  @default("FRONT")
  // URL d'aperçu PNG (généré une fois lors du seed)
  thumbnailUrl String?
  // JSON pdfme : { basePdf, schemas: [[...]] }
  data         String
  isPublic     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designs DesignDraft[]

  @@index([productType, variant])
}

// ─── DESIGN DRAFT ─────────────────────────────────────────────────────────
// Une instance customisée d'un Template par un user. Stocke les valeurs
// saisies dans le form ainsi que l'URL du PDF final (si finalisé).
// À l'add-to-cart, on convertit ce draft en `Order.files`.

model DesignDraft {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  // JSON : { fieldName: value, ... } selon le schema du template
  values String

  // URL S3 (ou data: URL en dev) vers le PDF print-ready généré
  finalPdfUrl String?

  // Lien vers l'Order où ce design a été utilisé (set par /api/orders/create
  // quand le payload contient un designId). Null = brouillon pas commandé.
  // Permet le tracking conversion "design → order" + stats par template.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  /** Cloisonnement des INVITÉS (audit pré-lancement 2026-07, P1-5).
   *  Tous les visiteurs non connectés partagent UNE seule row User
   *  (`guest@plio.local`) — donc filtrer par `userId` ne les sépare PAS entre
   *  eux : un invité qui obtenait le draftId d'un autre (Referer, URL partagée)
   *  pouvait ÉCRASER son design. Ce jeton, tiré aléatoirement et gardé dans un
   *  cookie httpOnly, identifie le navigateur invité. Null pour les drafts de
   *  comptes réels, où `userId` suffit déjà. */
  guestToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([guestToken])
}

// ─── WEBHOOK EVENT ────────────────────────────────────────────────────────
// Idempotence des webhooks. Stripe et Sinalite peuvent retry — on ne
// re-traite jamais un eventId déjà vu.

model WebhookEvent {
  id          String   @id @default(cuid())
  // STRIPE | SINALITE | SES (Round 39 #4 SNS bounce/complaint)
  source      String
  // ID unique du webhook (evt_xxx pour Stripe, généré pour Sinalite)
  eventId     String
  // Type d'event pour log/debug (ex: payment_intent.succeeded)
  eventType   String
  processedAt DateTime @default(now())

  // Outcome tracking — patché en fin de handler par updateWebhookOutcome.
  // `@default(true)` reste pour compat des rows historiques + le chemin
  // recordWebhookOutcome (qui set success explicitement).
  // Audit v2 #2.2 — recordWebhookEvent crée désormais la row avec
  // `success=false` (CLAIM pessimiste) et updateWebhookOutcome la flippe à
  // `true` au succès. Ainsi `success=true` signifie sans ambiguïté « traité
  // avec succès » → la dédup ne s'active que sur succès confirmé, et un échec
  // transitoire n'empêche plus le retry Stripe/SNS de re-traiter.
  success     Boolean  @default(true)
  statusCode  Int?
  latencyMs   Int?
  error       String?
  // Link vers l'Order si on a pu résoudre — accélère les joins admin.
  // FK + SetNull pour qu'un Order supprimé n'orphan pas la WebhookEvent
  // row (qu'on garde pour audit / replay).
  orderId     String?
  order       Order?   @relation("OrderWebhookEvents", fields: [orderId], references: [id], onDelete: SetNull)

  // Raw body du webhook — null pour les rows pré-migration. Stocké comme
  // string brute (pas parsé) pour replay fidèle. Limit pratique : Stripe
  // events ~5-50 KB, Sinalite < 1 KB. PostgreSQL TEXT pas de limite hard.
  payload     String?
  // Replay tracking : combien de fois l'admin l'a re-déclenché manuellement.
  // L'historique détaillé (qui, quand, outcome) vit dans WebhookReplay (Round 26 #3).
  replayCount Int      @default(0)
  lastReplayAt DateTime?
  replays     WebhookReplay[]

  @@unique([source, eventId])
  @@index([source, processedAt])
  @@index([success, processedAt])
  @@index([orderId])
}

// ─── ADMIN AUDIT EVENT ────────────────────────────────────────────────────
// Trace des actions admin sensibles (impersonation/view-as, refunds manuels,
// cancellation manuelle, etc.). Append-only — jamais update/delete. Sert
// pour audit interne + compliance + détection d'abus admin.

model AdminAuditEvent {
  id          String   @id @default(cuid())
  /** ADMIN_VIEW_AS_USER | ADMIN_MANUAL_REFUND | ADMIN_MANUAL_CANCEL | ADMIN_RESEND_EMAIL | ADMIN_TEMPLATE_EDIT */
  kind        String
  /** L'admin qui a posé l'action (toujours présent — admin auth required). */
  adminId     String
  adminEmail  String
  /** Le target (user, order, template…) si applicable. */
  targetType  String?  // 'USER' | 'ORDER' | 'TEMPLATE'
  targetId    String?
  /** JSON arbitraire pour stocker le contexte (URL visitée, montant refund, etc.). */
  data        String?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([kind, createdAt])
  @@index([targetType, targetId])
}

// ─── EMAIL DELIVERY ──────────────────────────────────────────────────────
// Queue + retry tracking pour tous les emails best-effort. Avant : un fail
// SES = email perdu silencieusement (juste un log). Maintenant : row
// persisté + retry exponential backoff via cron + visibilité admin.
//
// Status flow :
//   PENDING → SENT (succès au premier essai)
//   PENDING → FAILED (échec transitoire, sera retried)
//   FAILED → SENT (retry réussi)
//   FAILED → DEAD (3 attempts épuisés, manual intervention requise)

model EmailDelivery {
  id            String    @id @default(cuid())
  /** Destinataire (UNE seule adresse — pas de multi-recipient pour simplifier le retry). */
  to            String
  /** Template name (correspond à EmailTemplate union). */
  template      String
  /** Vars JSON-serialized (replayable au retry sans avoir à recomposer). */
  varsJson      String
  /** Subject override optionnel (sinon généré depuis EMAIL_SUBJECTS). */
  subject       String?
  /** Reply-To header optionnel. */
  replyTo       String?

  /** PENDING (queued) | SENT (success) | FAILED (transitoire, sera retried) | DEAD (max attempts épuisés) */
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  /** Max attempts avant DEAD. Default 3 (initial + 2 retries). */
  maxAttempts   Int       @default(3)
  lastError     String?
  /** Quand retry le prochain. NULL = retry ASAP au prochain cron. */
  nextAttemptAt DateTime?
  /** Set quand status passe à SENT. */
  sentAt        DateTime?
  /** Label optionnel pour grouper/dédup (orderId, action, etc.). */
  label         String?
  /** Si set, processDelivery génère la facture PDF de cet order à la volée
   *  et l'attache à l'email (idempotent au retry — pas de bytes en DB).
   *  FK avec SetNull pour qu'un Order supprimé ne crashe pas le retry —
   *  l'email part juste sans attachment. */
  attachOrderId String?
  attachOrder   Order?  @relation("OrderEmailAttachments", fields: [attachOrderId], references: [id], onDelete: SetNull)
  /** Première fois que le destinataire a ouvert l'email (pixel tracking).
   *  NULL = pas encore ouvert (ou client mail bloque les images). */
  openedAt      DateTime?
  /** Nombre d'ouvertures (incrémenté à chaque pixel hit, même par le
   *  même destinataire qui rouvre). Utile pour distinguer un email qui
   *  marque mais que personne ne re-consulte vs un sticky email. */
  openCount     Int      @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([label])
  @@index([createdAt])
}

// ─── NEWSLETTER ──────────────────────────────────────────────────────────
// Lead capture pour les visiteurs qui ne convertissent pas immédiatement.
// CASL-compliant : consentement EXPRESS via la coche du form (pas
// d'auto-subscribe). Unsubscribe self-serve via /api/newsletter/unsubscribe.
//
// Source = trace d'où l'inscription vient (landing-footer, popup, etc.)
// pour mesurer la conversion par placement.

model NewsletterSubscriber {
  id            String    @id @default(cuid())
  email         String    @unique
  /** D'où vient l'inscription (landing-footer, popup, /pricing, etc.). */
  source        String?
  /** IP au moment de l'inscription — preuve de consentement CASL en cas de litige. */
  consentIp     String?
  consentUa     String?
  status        String    @default("ACTIVE") // ACTIVE | UNSUBSCRIBED | BOUNCED
  subscribedAt  DateTime  @default(now())
  unsubscribedAt DateTime?
  /** Last campaign sent (pour stats engagement plus tard). */
  lastSentAt    DateTime?

  @@index([status, subscribedAt])
}

// ─── EMAIL BROADCAST ─────────────────────────────────────────────────────
// Newsletter / annonce envoyée à un segment d'audience par admin.
// Sert d'historique + audit + tracking de delivery stats.
//
// Segments supportés (MVP) :
//   - 'newsletter'  : NewsletterSubscriber actifs (CASL express)
//   - 'customers'   : User avec >=1 order PAID, opted-in delivery notifs
//                     (CASL implied — existing business relationship < 2 ans)
//   - 'all'         : union des deux (dédup par email)
//
// Status :
//   DRAFT     : brouillon admin, jamais envoyé (futur)
//   QUEUED    : enqueué dans EmailDelivery, en cours d'envoi
//   SENT      : tous les emails enqueués (succès ou pas)

model EmailBroadcast {
  id              String   @id @default(cuid())
  /** Subject ligne — ce que voit le destinataire dans son inbox. */
  subject         String
  /** Body texte brut (markdown-light : paragraphes séparés par \\n\\n). */
  body            String
  /** Segment cible : 'newsletter' | 'customers' | 'all'. */
  segment         String
  /** Nombre d'emails effectivement enqueued (post-dedup, post-opt-out filter). */
  recipientCount  Int      @default(0)
  /** Status workflow. QUEUED → SENT après processing. Round 19 #4 ajoute
   *  SCHEDULED qui attend que scheduledAt soit passé, et CANCELLED si
   *  admin annule avant. */
  status          String   @default("QUEUED")
  /** Admin qui a déclenché — email pour audit (l'id User peut être supprimé). */
  adminEmail      String
  /** Optional admin notes (campagne, contexte). */
  notes           String?

  /** Round 19 #4 — quand programmer l'envoi. NULL = envoyer immédiatement
   *  (legacy comportement). Si SET + futur → status=SCHEDULED, le cron
   *  /api/cron/broadcasts processe quand scheduledAt < now. */
  scheduledAt     DateTime?

  createdAt       DateTime @default(now())
  sentAt          DateTime?

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, scheduledAt])
}

// ─── REVIEW ──────────────────────────────────────────────────────────────
// Reviews customer après livraison. Trigger : webhook Sinalite DELIVERED
// → email "leave a review" avec token unique (HMAC orderId).
//
// Modération : reviews créées en status PENDING. Admin approve/reject
// dans /admin/reviews avant publication landing.

model Review {
  id            String   @id @default(cuid())
  /** Order qui a généré la review — unique pour éviter spam. */
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /** Rating 1-5 stars. */
  rating        Int
  /** Comment libre (optional, peut être null si rating-only). */
  comment       String?
  /** Display name (firstName from User OR custom). */
  displayName   String
  /** PENDING | APPROVED | REJECTED — modération admin requise avant
   *  affichage public sur landing. */
  status        String   @default("PENDING")
  /** Featured = mis en avant sur landing (top 3). */
  isFeatured    Boolean  @default(false)
  /** Rejection reason si REJECTED — pour debug + audit. */
  adminNote     String?

  /** Round 25 #4 — réponse publique de l'admin (style Trustpilot). NULL si
   *  pas encore répondu. Affiché sous le comment sur la card public review. */
  adminReply    String?
  /** Round 25 #4 — quand la réponse a été postée. Sert au tri "récemment
   *  répondu" + display "Plio a répondu il y a X". */
  adminReplyAt  DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  @@index([status, publishedAt])
  @@index([isFeatured, publishedAt])
}

// ─── PROMO CODE ───────────────────────────────────────────────────────────
// Codes promo appliqués au checkout. Discount soit en pourcentage soit en
// cents fixes (XOR — un seul des deux est non-null). Restrictions
// optionnelles : minimum subtotal, expiration, max uses total, premier
// achat seulement, type de produit. Compteur usesCount incrémenté
// atomiquement à la création de l'Order.

model PromoCode {
  id              String    @id @default(cuid())
  /** Code visible utilisateur, normalisé en upper. Ex: "BIENVENUE10". */
  code            String    @unique
  /** Label admin (ex: "Campagne newsletter mai 2026"). Optionnel. */
  label           String?
  /** Discount en % (1-100). Mutuellement exclusif avec discountCents. */
  discountPct     Int?
  /** Discount en cents. Mutuellement exclusif avec discountPct. */
  discountCents   Int?
  /** Faux = désactivé, ne plus accepter. */
  active          Boolean   @default(true)
  /** Si présent et < now() → expirée. */
  expiresAt       DateTime?
  /** Si présent et usesCount >= maxUses → épuisée. */
  maxUses         Int?
  /** Incrémenté à chaque Order créée avec ce code. */
  usesCount       Int       @default(0)
  /** Si présent : subtotal < ce montant en cents → inadmissible. */
  minSubtotalCents Int?
  /** Si true : applique seulement si user.orders.count === 0. */
  firstOrderOnly  Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders          Order[]

  @@index([active, expiresAt])
}

// ─── PRODUCT OVERRIDE ─────────────────────────────────────────────────────
// L'admin peut surcharger ce qui vient de Sinalite pour un produit donné :
//   - le désactiver complètement (hide du catalogue customer)
//   - le promouvoir en featured (badge "Bestseller")
//   - renommer ou ré-écrire la description (override marketing)
//   - notes internes admin (free-text, pas exposé customer)
// Margin/markup est un placeholder pour plus tard (PR future).
//
// Identifié par sinaliteProductId (number) — pas de FK car Sinalite est
// l'API externe, on n'a pas de table Product locale. Un override peut
// pointer vers un product qui a disparu côté Sinalite : c'est OK, le
// helper applyProductOverrides() le filtre silencieusement.

model ProductOverride {
  id                  String   @id @default(cuid())
  /** ID Sinalite (unique). */
  sinaliteProductId   Int      @unique
  /** Si true : produit caché du catalogue customer (override Sinalite enabled). */
  disabled            Boolean  @default(false)
  /** Si true : badge "★ Bestseller" sur la card produit. */
  featured            Boolean  @default(false)
  /** Override le nom Sinalite (ex: "Cartes 14pt UV" → "Cartes UV brillantes"). */
  displayName         String?
  /** Override la description ou ajoute une description custom (Sinalite n'en
   *  fournit pas vraiment). Markdown supporté côté UI. */
  displayDescription  String?
  /** Markup en % appliqué au prix Sinalite à chaque variant lookup.
   *  NULL = pas de markup, 10 = +10%, -5 = -5% (rare mais possible).
   *  Appliqué à TOUS les prix du variantIndex pour ce produit. */
  marginPct           Int?
  /** JSON string array d'option IDs à cacher du wizard customer pour ce
   *  produit (ex: "[107,108]" pour exclure certains finishings). Utile
   *  pour limiter le catalogue sans toucher Sinalite. NULL = rien caché. */
  hiddenOptionIds     String?
  /** Notes internes admin (jamais affichées customer). */
  notes               String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([disabled])
  @@index([featured])
}

// ─── SAVED CONFIG ─────────────────────────────────────────────────────────
// Permet à un user de sauvegarder une configuration produit Sinalite sans
// passer commande, pour la retrouver d'un clic plus tard. Complète le flow
// "Recommander" (qui exige une commande PAIEMENT effectuée).
//
// Use cases :
//   - Designer prépare des cartes mais attend l'approbation du client →
//     sauve, revient plus tard pour upload + payer.
//   - Customer fidèle a 3 produits récurrents qu'il commande chaque
//     trimestre → 3 SavedConfigs persistants, deep-link sur /order/upload.
//   - Quick-restart : sur /order/start on affiche les 3 configs les plus
//     récemment utilisées comme tuiles "Reprendre".
//
// Snapshots : on stocke productName + summary pour pouvoir afficher la
// config même si Sinalite a retiré le produit (cas marginal mais on veut
// pas montrer "Produit inconnu"). Le deep-link, lui, retombera au notFound
// gracefully côté wizard si productId n'existe plus.

model SavedConfig {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Nom donné par l'user (ex: "Cartes biz UV 500ex"). */
  name        String
  /** Sinalite product ID. Pas de FK (Sinalite externe). */
  productId   Int
  /** Snapshot du nom produit Sinalite au moment de la sauvegarde (resilience
   *  si le produit disparaît Sinalite-side). */
  productName String
  /** IDs d'options sélectionnés (incl. qty + turnaround), JSON string array
   *  pour resilience cross-DB. Format : "[4,30,107,224,78]". */
  optionIds   String
  /** Snapshot human-readable, ex : "14pt UV brillante · 500 unités · Standard". */
  summary     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /** Bumpé chaque fois que l'user clique "Utiliser" (deep-link vers wizard). */
  lastUsedAt  DateTime?
  /** Compteur d'usage (analytics + sort par fréquence). */
  timesUsed   Int      @default(0)

  /** Round 18 #2 — Folder organization. NULL = pas dans un folder
   *  (display dans le "root" / "Tous"). Free-text 1-50 chars, normalisé
   *  lowercase au save pour matcher. Pas une table FoldersJoinTable :
   *  un folder existe = au moins 1 SavedConfig le référence. */
  folder      String?
  /** Round 18 #2 — Tags CSV (lowercase, comma-separated). Filter UI :
   *  "show me only configs with tag 'biz-cards' or 'recurring'".
   *  Garde un format simple (CSV) plutôt qu'un m:n parce que < 5 tags
   *  par config typique + lookup ne nécessite pas d'index. */
  tags        String?

  @@index([userId, lastUsedAt])
  @@index([userId, createdAt])
  @@index([userId, folder])
}

// ─── API KEY ──────────────────────────────────────────────────────────────
// Clés API pour l'accès programmatique au MCP (mutations type create_order).
// On ne stocke JAMAIS le secret en clair : `keyHash` = SHA-256 hex du token
// complet, vérifié par lookup indexé (pas par comparaison → pas de timing-safe
// requis : l'attaquant ne contrôle pas la préimage d'un hash de 256 bits).
// `keyPrefix` = début affichable (ex: "plio_sk_live_a1b2c3") pour repérer la clé
// dans une liste — PAS @unique (collision sur peu de chars ferait planter le
// minting ; l'unicité d'auth est garantie par keyHash). scopes = CSV lowercase
// contraint app-side (parseScopes, whitelist API_KEY_SCOPES — pas d'enum Prisma).
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Label donné par l'user (ex: "Agent Claude", "Script export n8n"). */
  name        String
  /** Préfixe affichable (préfixe fixe + qq chars du secret). Repère visuel, non secret. */
  keyPrefix   String
  /** SHA-256 hex (64 chars lowercase) du token complet. Index de lookup d'auth. */
  keyHash     String    @unique
  /** Scopes CSV lowercase (ex: "orders:write"). "" = aucun. Contraint via parseScopes. */
  scopes      String    @default("")
  /** Dernière présentation valide de la clé (throttlé : maj si > 60 s). NULL = jamais. */
  lastUsedAt  DateTime?
  /** Expiration optionnelle. NULL = pas d'expiration. */
  expiresAt   DateTime?
  /** Révocation manuelle (soft). NULL = active. Filtré à la vérif ET à la suppression Loi 25. */
  revokedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, createdAt])
}

// ─── MCP ORDER INTENT ─────────────────────────────────────────────────────
// Idempotence des commandes passées via le MCP (Mode B, paiement headless).
// CLAIM pessimiste (success=false) AVANT toute écriture Order/Stripe ; flippé à
// true seulement quand l'Order + la Checkout Session sont créés. Un retry de
// l'agent (même idempKey dérivée de données STABLES — cf. deriveIdempKey) tombe
// sur la contrainte @@unique → on renvoie le 1er résultat (orderId + checkoutUrl)
// au lieu de créer une 2e commande/charge. orderId écrit AU claim (pas en post)
// pour qu'un crash entre create et complete reste rejouable. Calqué sur
// WebhookEvent (claim+success). Keyé par userId → pas de collision cross-tenant.
model McpOrderIntent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hash stable (sha256) de (nonce agent + userId + items + shipping + promo). Voir deriveIdempKey.
  idempKey    String
  /// Order créé (écrit au claim, AVANT la Checkout Session, pour la reprise sur crash).
  orderId     String?
  /// URL de paiement Stripe Checkout hébergée (renvoyée telle quelle sur replay complété).
  checkoutUrl String?
  /// false = claim en cours / échoué ; true = Order + Session créés (dedup légitime).
  success     Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, idempKey])
  @@index([success, createdAt])
}

// ─── REFERRAL ─────────────────────────────────────────────────────────────
// Double-sided referral : quand un filleul passe sa 1ère commande payée,
// le référent ET le filleul reçoivent du crédit (User.referralCreditCents).
// Le crédit est auto-appliqué au prochain checkout.
//
// One record par paire (referrer, referee) — l'unique sur refereeUserId
// garantit qu'un user ne peut être filleul qu'une seule fois (anti-abuse).
//
// Statuses :
//   PENDING   : référent identifié mais commande pas encore payée
//   CREDITED  : commande payée, crédit appliqué des deux côtés
//   VOIDED    : commande annulée/refundée → crédit invalidé (admin manual)

model ReferralReward {
  id              String   @id @default(cuid())
  referrerId      String
  referrer        User     @relation("ReferralReferrer", fields: [referrerId], references: [id])
  refereeUserId   String   @unique
  referee         User     @relation("ReferralReferee", fields: [refereeUserId], references: [id])
  /** Order qui a triggered le credit (1ère commande payée du filleul).
   *  FK + SetNull pour qu'un Order supprimé n'orphan pas le ReferralReward
   *  (qu'on garde pour audit referral). UNIQUE = max 1 reward par order. */
  refereeOrderId  String?  @unique
  refereeOrder    Order?   @relation("OrderReferralReward", fields: [refereeOrderId], references: [id], onDelete: SetNull)
  /** Cents de crédit attribués à CHAQUE side (typique 1000 = 10$ CAD). */
  creditCents     Int
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  creditedAt      DateTime?

  @@index([referrerId, createdAt])
  @@index([status])
}

// ─── SAMPLE REQUEST ───────────────────────────────────────────────────────
// Customer demande un kit d'échantillons (gratuit, max 5 par personne par
// mois). Pas de login required — collect email + adresse, admin assemble
// et ship via Postes Canada. Lead generation tool : conversion vers
// commande payée typique 25-35 %.
//
// Anti-abuse : unique sur (email, jourMonth) à l'app level (lookup avant
// create), pas au DB level pour permettre les corrections admin.

// ─── CONTACT MESSAGE ──────────────────────────────────────────────────────
// Persiste chaque submission du formulaire /contact + FloatingHelpButton
// pour donner à l'admin un thread tracking (au lieu de chercher dans
// Gmail). Le email reste envoyé via SES, on ajoute juste la DB pour
// l'historique + status management.
//
// Status :
//   OPEN     : nouveau, pas répondu
//   ANSWERED : admin a répondu (manuellement noté ou auto via webhook)
//   CLOSED   : ticket résolu, archivé
//
// Anti-spam : on stocke requestIp/Ua pour analyser les patterns suspects.
// Pas de bayesian filter pour MVP — rate-limit + manual review.

model ContactMessage {
  id              String    @id @default(cuid())
  /** Email du demandeur. */
  email           String
  /** Nom complet. */
  name            String
  /** Sujet original du message. */
  subject         String
  /** Body du message (markdown plain). */
  message         String
  /** OPEN | ANSWERED | CLOSED — workflow admin. */
  status          String    @default("OPEN")
  /** Notes internes admin (jamais affichées customer). */
  adminNotes      String?
  /** Si lié à un Order spécifique (extracted du subject ou du body).
   *  FK + SetNull pour garder le ContactMessage si l'Order disparait
   *  (le message reste pertinent pour le customer support). */
  orderId         String?
  order           Order?    @relation("OrderContactMessages", fields: [orderId], references: [id], onDelete: SetNull)
  /** Source : 'contact-form' | 'help-fab' | 'wizard-help'. */
  source          String?
  /** IP + UA pour anti-spam. */
  requestIp       String?
  requestUa       String?

  createdAt       DateTime  @default(now())
  answeredAt      DateTime?
  closedAt        DateTime?

  @@index([status, createdAt])
  @@index([email, createdAt])
}

// ─── RESELLER APPLICATION ─────────────────────────────────────────────────
// Agence / freelance / studio qui veut revendre du print Plio à ses clients.
// Application form gating l'accès au tarif reseller (blind shipping + remise
// volume). Admin manuellement approve/reject — on a besoin de filtrer les
// vrais resellers vs les particuliers qui veulent juste un rabais.
//
// Status :
//   PENDING   : nouvelle demande, admin n'a pas encore tranché
//   APPROVED  : admin a accepté → User row associé reçoit le tier reseller
//               (future implementation : pricing override automatique)
//   REJECTED  : admin a refusé (volume insuffisant, mauvais fit, etc.)
//   ARCHIVED  : reseller actif qui ne mérite plus le tracking actif

model ResellerApplication {
  id              String    @id @default(cuid())
  /** Nom légal de l'entreprise / studio. */
  companyName     String
  /** Personne contact principale. */
  contactName     String
  /** Email de contact — sert aussi de dedup key (1 application par email). */
  email           String
  phone           String?
  /** URL du site / portfolio (optional mais fortement recommandé). */
  website         String?
  /** Volume mensuel estimé (cents CAD) — drives le tier de discount. */
  estimatedMonthlyCents Int?
  /** Solution actuelle (Vistaprint, imprimeur local, etc.) — pour comprendre
   *  où on les chip. */
  currentSolution String?
  /** Types de produits principaux (cartes, flyers, brochures, signage…). */
  projectTypes    String?
  /** Message libre — pitch du reseller, contexte particulier. */
  message         String?

  status          String    @default("PENDING")
  adminNotes      String?
  /** IP + UA pour anti-spam analysis. */
  requestIp       String?
  requestUa       String?

  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([email, createdAt])
  @@index([status, createdAt])
}

// ─── CUSTOM QUOTE REQUEST ────────────────────────────────────────────────
// Demande de devis sur-mesure pour jobs hors catalogue : grande quantité,
// papier spécifique, finish unusual (gaufrage, stamping métal), substrats
// rigides (foamcore, dibond), assemblage manuel, etc.
//
// Workflow : customer fill form → admin reçoit email + Slack → admin
// rédige le quote manuel → renvoie via email (Reply-To setté) → customer
// place commande directement à partir du quote (paiement Stripe link
// envoyé manually pour MVP).
//
// Status :
//   PENDING   : nouvelle demande, admin n'a pas encore tranché
//   QUOTED    : admin a envoyé une réponse avec quote
//   ACCEPTED  : customer a confirmé qu'il achète (manual flag par admin)
//   REJECTED  : customer pas intéressé OU on peut pas faire
//   ARCHIVED  : closed sans suite après timeout

model CustomQuoteRequest {
  id                  String   @id @default(cuid())
  /** Email du demandeur — sert aussi de lookup key. */
  email               String
  /** Nom complet. */
  name                String
  /** Optionnel — pour follow-up téléphonique sur les gros dossiers. */
  phone               String?
  /** Nom de la company / studio si applicable. */
  companyName         String?
  /** Type de projet (free text — "cartes premium", "signage extérieur",
   *  "kit packaging custom"). */
  projectType         String
  /** Quantité estimée (string car peut être "500-1000" ou "à déterminer"). */
  estimatedQuantity   String?
  /** Deadline souhaitée (string ISO ou texte libre "fin juillet"). */
  deadline            String?
  /** Budget estimé en cents CAD (optionnel — souvent les gens ne savent pas). */
  budgetCents         Int?
  /** Description détaillée du projet — papier, format, finish, finition. */
  description         String
  /** PENDING | QUOTED | ACCEPTED | REJECTED | ARCHIVED */
  status              String   @default("PENDING")
  /** Réponse admin (quote brouillon + notes). */
  adminResponse       String?
  /** Notes internes admin. */
  adminNotes          String?
  /** IP + UA pour anti-spam. */
  requestIp           String?
  requestUa           String?

  createdAt           DateTime  @default(now())
  quotedAt            DateTime?
  decidedAt           DateTime?

  @@index([status, createdAt])
  @@index([email, createdAt])
}

// ─── ACCOUNT DELETION REQUEST ────────────────────────────────────────────
// Demande LPRPDE/PIPEDA de suppression de compte. Admin traite manuellement
// (vérif commandes en cours, identité). Workflow :
//   PENDING   : user a soumis la demande
//   APPROVED  : admin valide, prêt à exécuter
//   PROCESSED : suppression effectuée (User row anonymisée — on garde l'historique
//               commandes facturées pour obligation fiscale 6 ans, mais on
//               nullifie email/name/phone/addresses)
//   REJECTED  : admin refuse (ex: enquête fraude en cours)
//
// Conservation 6 ans des commandes : LIR (loi impôt fédérale) art. 230.

model DeleteAccountRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Email à la soumission — utile si on doit retracer après suppression. */
  emailSnapshot String
  /** Raison libre du user (optionnel). */
  reason      String?
  /** PENDING | APPROVED | PROCESSED | REJECTED */
  status      String   @default("PENDING")
  /** Notes admin (raison du REJECTED, ou check-list APPROVED). */
  adminNotes  String?

  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  processedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

model SampleRequest {
  id                  String   @id @default(cuid())
  /** Email du demandeur — sert aussi de lookup key contre les doublons. */
  email               String
  /** Nom complet pour adressage. */
  name                String
  /** Optionnel — pour SMS de notification livraison. */
  phone               String?
  /** Adresse de livraison (snapshot, on n'attache pas à Address book). */
  shipLine1           String
  shipLine2           String?
  shipCity            String
  shipProvince        String
  shipPostalCode      String
  /** JSON array des noms d'échantillons sélectionnés
   *  (ex: '["14pt Coated","16pt Coated","Spot UV"]'). Max 5 enforced
   *  côté API. */
  selectedSamples     String
  /** Note libre du customer (use case, projet à venir, etc.). */
  message             String?
  /** PENDING | SHIPPED | CANCELLED — admin transitionne via UI. */
  status              String   @default("PENDING")
  /** Tracking number Postes Canada quand SHIPPED (optionnel). */
  trackingNumber      String?
  /** Notes internes admin (jamais affichées customer). */
  adminNotes          String?
  /** IP + UA pour anti-spam analysis si nécessaire. */
  requestIp           String?
  requestUa           String?

  createdAt           DateTime  @default(now())
  shippedAt           DateTime?

  @@index([email, createdAt])
  @@index([status, createdAt])
}

// ─── EXPERIMENT OVERRIDE ─────────────────────────────────────────────────
// Admin override du flag `active` pour une expérience A/B. La structure
// (variants, weights, label) reste code-defined dans src/lib/ab/experiments.ts.
// Cette table sert juste à toggler on/off sans redeploy + future : override
// des poids pour ramp up progressif.

model ExperimentOverride {
  id           String   @id @default(cuid())
  /** Match EXPERIMENTS key. Unique car 1 row par experiment. */
  experimentId String   @unique
  /** True = expérience active (assignation random). False = tout le monde
   *  voit le control. Si pas de row : code default (Experiment.active). */
  active       Boolean
  /** Optionnel — JSON `{ variantId: weight }` pour override les poids
   *  code-defined. Permet de shift 50/50 → 90/10 sans redeploy. NULL = code default. */
  weightsJson  String?
  /** Email de l'admin qui a fait le dernier change (audit lite). */
  updatedBy    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── NPS RESPONSE ────────────────────────────────────────────────────────
// Net Promoter Score feedback — interne uniquement (jamais affiché public).
// Distinct du `Review` model (5★ + comment, modéré, public landing) :
//   - NPS = score 0-10 + free-text "pourquoi", non-modéré, admin-only
//   - Une réponse par order, idempotent via @unique sur orderId
//
// Bucket convention :
//   - 0-6  : Detractor
//   - 7-8  : Passive
//   - 9-10 : Promoter
// NPS score = % promoters - % detractors (range -100 à +100).

model NpsResponse {
  id        String   @id @default(cuid())
  /** Order qui a généré la réponse — unique = max 1 NPS par order. */
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /** Score 0-10 inclus. Contrainte app-side via Zod. */
  score     Int
  /** Pourquoi cette note (free-text, max 2000 chars). NULL si user
   *  a juste cliqué le score sans expliquer. */
  comment   String?

  createdAt DateTime @default(now())

  @@index([score, createdAt])
  @@index([createdAt])
}

// ─── ABANDONED CART ──────────────────────────────────────────────────────
// Capture les visiteurs (anonymes ou loggés) qui ont atteint /order/shipping
// (= ont saisi leur email) mais n'ont pas finalisé. Cron /api/cron/abandoned-
// cart envoie 1 email recovery 24h après. Dédup via emailSentAt + auto-skip
// si une Order existe pour cet email après updatedAt.

model AbandonedCart {
  id          String   @id @default(cuid())
  /** Email saisi au step shipping. Lowercase, validé Zod côté API. */
  email       String
  /** ProductId Sinalite — pour retourner au bon produit. */
  productId   Int
  /** Snapshot serialized des options sélectionnées (querystring params).
   *  Permet de reconstruire le deep-link vers /order/review.
   *  Format : "options=12,34&files=front:url|back:url&ship=..." */
  resumeQuery String
  /** Step atteint (configure | quantity | upload | shipping | review).
   *  Si review → 95 % chance de checkout, on n'email pas. */
  lastStep    String
  /** Timestamp d'envoi du recovery email. NULL = pas encore envoyé.
   *  Set après envoi pour dédup. */
  emailSentAt DateTime?
  /** Round 27 #1 — timestamp du premier click sur le link recovery dans
   *  l'email. NULL = pas encore cliqué. Set par GET /api/recovery/click,
   *  permet de calculer le funnel sent → clicked → recovered. */
  recoveryClickedAt DateTime?

  /** Round 27 #1 — Orders qui ont été créées suite à ce cart abandonné.
   *  Back-relation pour le funnel "recovered" count. */
  recoveredOrders Order[] @relation("OrderRecoveredFromCart")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /** Lookup principal : trouver les carts à processer. */
  @@index([emailSentAt, updatedAt])
  /** Anti-spam : retrouver vite si déjà capturé pour cet email. */
  @@index([email, updatedAt])
  /** Round 16 #4 : UNIQUE pour fix la race condition (2 POSTs concurrents
   *  pour le même (email, productId) créaient 2 rows). L'API utilise
   *  maintenant prisma.upsert sur ce composite key — atomique côté DB. */
  @@unique([email, productId])
}

// ─── CRON RUN HISTORY ────────────────────────────────────────────────────
// Trace les runs des cron jobs (cleanup, daily-summary, email-retry,
// re-engagement) pour /admin/crons. Permet de voir last run, success rate,
// latence, error message sans dépendre de Healthchecks.io (qui sert juste
// d'alerting timeout).

model CronRun {
  id          String   @id @default(cuid())
  /** Nom du cron (cleanup | daily-summary | email-retry | re-engagement | ...). */
  name        String
  /** 'success' | 'fail'. */
  status      String
  /** Durée du run en millisecondes. */
  latencyMs   Int
  /** Message d'erreur si fail (truncated 500 chars). */
  errorMessage String?
  /** Contexte structuré du run (ex: count emails envoyés). JSON-stringified. */
  data        String?

  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ─── EXPERIMENT EVENTS (assignments + conversions) ───────────────────────
// Pour mesurer une expérience A/B il faut tracker :
//   1. ASSIGNMENT : qui a vu quelle variant (1ère exposure)
//   2. CONVERSION : qui a fait l'action de succès (achat, signup, etc.)
//
// On dédupe les assignments par (experimentId, visitorId) pour pas surcompter
// — un visiteur qui rafraîchit 50 fois ne compte que 1.
//
// visitorId = cookie anonyme `plio_vid` (cuid) écrit au 1er render. Permet
// d'attribuer même aux visiteurs non-loggés. Si user signin plus tard, on
// peut joindre via UserVisitor mapping (future).

model ExperimentAssignment {
  id           String   @id @default(cuid())
  experimentId String
  variantId    String
  /** Cookie plio_vid (anonyme cuid). */
  visitorId    String
  /** User connecté au moment de l'assignment, si applicable. NULL pour anonymes. */
  userId       String?
  createdAt    DateTime @default(now())

  /** Dédup : un visiteur ne crée qu'1 assignment par expérience. */
  @@unique([experimentId, visitorId])
  @@index([experimentId, variantId, createdAt])
  @@index([userId])
}

model ExperimentConversion {
  id           String   @id @default(cuid())
  experimentId String
  variantId    String
  visitorId    String
  userId       String?
  /** Nom du goal (ex: 'order_placed', 'signup_completed'). Permet de tracker
   *  plusieurs goals par expérience. */
  goal         String
  /** Optionnel : valeur quantifiable (cents revenue, count, etc.). */
  value        Int?
  createdAt    DateTime @default(now())

  @@index([experimentId, variantId, goal, createdAt])
  @@index([visitorId, createdAt])
}

// ─── SINALITE OFFLINE CACHE ──────────────────────────────────────────────
// Cache write-through pour les endpoints catalog (listProducts, product
// detail). Si Sinalite API est down, on sert depuis cette table (stale)
// au lieu d'un 500 — le wizard reste utilisable, juste avec des prix
// potentiellement périmés.
//
// Key = URL path Sinalite (ex: "/product", "/product/7/PLIO"). Payload =
// JSON-stringified response. updatedAt = quand on a rafraîchi pour la
// dernière fois. Caller décide TTL.

model SinaliteCacheEntry {
  id        String   @id @default(cuid())
  /** URL path Sinalite (unique, ex: "/product", "/product/7/PLIO"). */
  key       String   @unique
  /** Response JSON-stringified. PostgreSQL TEXT — pas de limite hard,
   *  les payloads les plus gros tournent autour de 500 KB (listProducts). */
  payload   String
  /** Status HTTP de la dernière réponse cachée. 200 typically. */
  statusCode Int     @default(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── WALLET TRANSACTIONS (Round 18 #1) ──────────────────────────────────
// Append-only ledger des mouvements wallet customer. Le balance courant
// est cached sur User.walletCents (pour query rapide au checkout sans
// agréger toutes les rows), mais peut être reconstitué via :
//   SELECT SUM(amountCents) FROM WalletTransaction WHERE userId=X
//
// Kinds :
//   TOPUP             : achat de crédit via Stripe Checkout (+)
//   TOPUP_BONUS       : bonus tier (5/8/12 %) ajouté au TOPUP (+)
//   ORDER_SPEND       : utilisation au checkout (-)
//   REFUND            : crédit reversé suite à cancel/refund order (+)
//   ADMIN_ADJUSTMENT  : correction manuelle admin (+ ou -)
//   EXPIRY            : credit expiré (politique future) (-)

model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("WalletTransactionUser", fields: [userId], references: [id], onDelete: Cascade)
  /** TOPUP | TOPUP_BONUS | ORDER_SPEND | REFUND | ADMIN_ADJUSTMENT | EXPIRY */
  kind          String
  /** Signed cents : + pour credit, - pour debit. */
  amountCents   Int
  /** Snapshot du User.walletCents APRÈS cette transaction (audit). */
  balanceAfterCents Int
  /** Stripe PaymentIntent ID (pour TOPUP). NULL pour autres kinds. */
  paymentIntentId String?
  /** OrderId si lié à un order (ORDER_SPEND, REFUND).
   *  Round 37 #4 — Ajout FK + SetNull. Avant : String? sans relation
   *  → orphans possibles (orderId pointait vers Order supprimé sans contrainte).
   *  SetNull preserve le ledger row si l'order rare cas où Order est purge. */
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /** AdminId si ADMIN_ADJUSTMENT, REFUND par admin.
   *  Round 37 #4 — Ajout FK + SetNull (admin peut être supprimé via PIPEDA). */
  adminId       String?
  adminUser     User?    @relation("WalletTransactionAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  /** Description libre (ex: "Topup $500 → +25$ bonus", "Refund order #SIN-1234"). */
  description   String

  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([paymentIntentId])
  /** Round 37 #4 — Index sur FK orderId pour /admin/orders/[id] wallet tab + reconcile queries. */
  @@index([orderId])
  /** Round 37 #4 — Index sur FK adminId pour "actions de cet admin" queries. */
  @@index([adminId])
}

// ─── WEBHOOK REPLAY HISTORY ───────────────────────────────────────────────
// Round 26 #3. Track chaque manual replay (single ou via bulk) d'un
// WebhookEvent. L'aggregate count + lastReplayAt restent sur WebhookEvent
// pour query rapide, mais l'historique détaillé vit ici.
//
// Use case admin : "ce webhook a été replay 4 fois — quand, par qui,
// quels furent les outcomes ?" → voir la table sur /admin/webhooks/[id].

// ─── ADMIN SAVED FILTER ──────────────────────────────────────────────────
// Round 26 #5. Permet à chaque admin de bookmarker une URL filtrée
// (ex: /admin/orders?status=PAID&q=urgent) avec un nom mnémonique.
// Affiché en dropdown "Mes filtres" en haut de la page concernée.
//
// scope = clé courte qui définit OÙ ce filtre est utilisable :
//   - "orders" : pages /admin/orders
//   - "users", "webhooks", "reviews"… (étendable plus tard)
//
// Per-admin (userId FK + Cascade) : pas de partage. Si un admin est
// supprimé, ses filtres partent avec lui.

model AdminSavedFilter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Surface admin où le filtre s'applique : "orders" | "users" | "webhooks"… */
  scope       String
  /** Nom mnémonique court (ex: "Refunds urgents"). Max 60 chars. */
  name        String
  /** Le query string complet à appliquer (ex: "status=PAID&q=urgent").
   *  Pas de leading ?, pas de prefixe path — juste la portion après le ?. */
  queryString String
  createdAt   DateTime @default(now())

  @@index([userId, scope, createdAt])
}

model WebhookReplay {
  id              String   @id @default(cuid())
  webhookEventId  String
  webhookEvent    WebhookEvent @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  /** Quand le replay a été déclenché. */
  replayedAt      DateTime @default(now())
  /** Admin qui a cliqué (User.id). NULL si replay automatique (futur). */
  replayedBy      String?
  /** Email snapshot pour affichage sans re-join User (admin peut être supprimé). */
  replayedByEmail String?
  /** true si le handler a retourné succès. */
  success         Boolean
  /** HTTP status code retourné par notre handler (200 = OK, 5xx = fail). */
  statusCode      Int?
  /** Error message (first 500 chars) si fail. */
  errorMessage    String?
  /** Latency du replay en ms. */
  latencyMs       Int?

  @@index([webhookEventId, replayedAt])
}

// ─── EMAIL SUPPRESSION (Round 39 #4) ──────────────────────────────────────
// Source of truth : une row ici = ne plus JAMAIS envoyer d'email à cette
// address, peu importe le template. Populé par :
//   - /api/webhooks/ses (SNS notification SES hard bounce / complaint)
//   - Futur : admin UI pour suppress manuel
//
// queueEmail() check `findUnique({where:{email}})` AVANT le throttle check
// et AVANT le INSERT EmailDelivery — bail out cleanly avec status='SUPPRESSED'.
//
// Pourquoi ce table vs réutiliser User.emailMarketing=false :
//   - emailMarketing ne couvre QUE le marketing → on continuerait d'envoyer
//     les transactionnels à une address hard-bounced → SES degrade encore
//     plus notre reputation Sender Score.
//   - Beaucoup d'addresses qui bounce n'ont pas de User row (newsletter
//     leads, sample requests, contact form senders). Cette table couvre
//     tout l'univers des "from" SES.
//
// Reasons :
//   HARD_BOUNCE  : bounce permanent (mailbox doesn't exist, domain gone)
//   COMPLAINT    : user a cliqué "spam" dans son client mail
//   MANUAL       : admin a suppress manuellement via UI

// ─── Prix vitrine « à partir de » des listes produits ────────────────────
//
// Pourquoi une table et pas un calcul au rendu : le min des variantes exige
// l'index Sinalite COMPLET (listVariants paginé — plusieurs secondes par
// produit, cf. src/lib/sinalite/pricing.ts). Impossible pour une liste de
// 5-45 produits dans une Lambda Amplify (timeout ~30 s, pas de promesse
// flottante post-réponse). Le cron refresh-product-prices balaie donc le
// catalogue par tranches (budget de temps, stalest-first) et upsert ici ;
// /order/product lit tout en UNE requête DB (~ms) et retombe sur
// « Voir prix → » pour les produits pas encore balayés.
model ProductStartingPrice {
  /** productId Sinalite (clé du catalogue fournisseur). */
  sinaliteProductId Int      @id
  /** Prix TOTAL minimal en cents, markup admin INCLUS (même source que le
   *  wizard : index enrichi). Null = balayé mais index vide/inexploitable. */
  minTotalCents     Int?
  /** Nb de variantes indexées au moment du calcul (observabilité). */
  variantCount      Int      @default(0)
  /** Dernier calcul — pilote l'ordre du sweep (jamais-calculé, puis plus vieux). */
  computedAt        DateTime @default(now())

  @@index([computedAt])
}

model EmailSuppression {
  id           String   @id @default(cuid())
  /** Lowercased email — UNIQUE empêche les doublons sur SNS replay. */
  email        String   @unique
  /** HARD_BOUNCE | COMPLAINT | MANUAL */
  reason       String
  /** SES_BOUNCE | SES_COMPLAINT | ADMIN | USER_UNSUB */
  source       String
  /** Message-ID SES pour traçabilité + dedup (les notifications SNS peuvent
   *  être livrées multiples fois — at-least-once delivery). */
  sesMessageId String?
  /** Free-form JSON pour bounceType/bounceSubType/complaintFeedbackType
   *  (audit + investigation). */
  details      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([reason])
}
