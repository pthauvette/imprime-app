{
  "ci": {
    "collect": {
      "settings": {
        "preset": "mobile",
        "throttlingMethod": "simulate",
        "skipAudits": [
          "uses-http2",
          "redirects-http"
        ],
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      },
      "numberOfRuns": 1
    },
    "assert": {
      "preset": "lighthouse:no-pwa"
    }
  }
}
